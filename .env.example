# Booking backend (leave empty to run the site in demo mode)
# Make.com custom webhook that receives the booking form POST
VITE_BOOKING_WEBHOOK_URL=

# Waitlist join backend (leave empty to run the waitlist prompt in demo mode)
# n8n webhook: WAITLIST - Offers & Cascade / Webhook - Join Waitlist (path: waitlist-join)
VITE_WAITLIST_WEBHOOK_URL=

# Contact form backend (leave empty to run the contact form in demo mode)
VITE_CONTACT_WEBHOOK_URL=

# Supabase project (read-only busy_slots view via the publishable/anon key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
